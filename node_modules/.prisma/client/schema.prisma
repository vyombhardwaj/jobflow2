// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime      @default(now())
  accounts      Account[]
  sessions      Session[]
  applications  Application[]
  contacts      Contact[]
  interviews    Interview[]
  notes         AppNote[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Application {
  id          String      @id @default(cuid())
  company     String
  role        String
  location    String?
  url         String?
  salary      String?
  status      String      @default("wishlist") // wishlist | applied | screening | interview | offer | rejected | accepted
  priority    String      @default("medium") // low | medium | high
  appliedDate DateTime?
  deadline    DateTime?
  jobType     String? // full-time | part-time | contract | remote
  description String?
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts    Contact[]
  interviews  Interview[]
  notes       AppNote[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Contact {
  id            String       @id @default(cuid())
  name          String
  title         String?
  email         String?
  linkedin      String?
  notes         String?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
}

model Interview {
  id            String      @id @default(cuid())
  type          String // phone | video | onsite | technical | behavioural
  scheduledAt   DateTime
  duration      Int? // minutes
  notes         String?
  outcome       String? // passed | failed | pending
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
}

model AppNote {
  id            String      @id @default(cuid())
  content       String
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
}
